{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/check.js": {
      "maxDuration": 300
    },
    "api/app.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/kabalot-app",
      "destination": "/index.html"
    },
    {
      "source": "/kabalot-app/tx/:token",
      "destination": "/index.html"
    },
    {
      "source": "/kabalot-app/api/check",
      "destination": "/api/check"
    },
    {
      "source": "/kabalot-app/api/:path*",
      "destination": "/api/app?p=:path*"
    },
    {
      "source": "/kabalot-app/:file",
      "destination": "/:file"
    },
    {
      "source": "/tx/:token",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/app?p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/check",
      "schedule": "17 9 * * *"
    }
  ]
}
